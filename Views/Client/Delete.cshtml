@model Client
@{
    ViewData["Title"] = "Delete Client";
}

<h1 class="mb-3">Client Management System</h1>
<h4 class="mb-3 text-danger">Delete Client</h4>

<div class="alert alert-warning">
    Are you sure you want to delete this client? This action cannot be undone.
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Client ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FullName)</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CompanyName)</dt>
            <dd class="col-sm-9">@Model.CompanyName</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.PhoneNumber)</dt>
            <dd class="col-sm-9">@Model.PhoneNumber</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ServiceRequired)</dt>
            <dd class="col-sm-9">@Model.ServiceRequired</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
        </form>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</div>
