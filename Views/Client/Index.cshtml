@model List<Client>
@{
    ViewData["Title"] = "Clients";
}

<h1 class="mb-3">Client Management System</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 text-muted">All Clients (@Model.Count)</h5>
    <a asp-action="Create" class="btn btn-primary">+ Add Client</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No clients yet. Click "Add Client" to create the first one.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Full Name</th>
                    <th>Company Name</th>
                    <th>Email</th>
                    <th>Phone Number</th>
                    <th>Service Required</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in Model)
                {
                    <tr>
                        <td>@client.Id</td>
                        <td>@client.FullName</td>
                        <td>@client.CompanyName</td>
                        <td>@client.Email</td>
                        <td>@client.PhoneNumber</td>
                        <td>@client.ServiceRequired</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-info text-white">View</a>
                            <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@client.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
